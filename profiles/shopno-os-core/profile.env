# =============================================================================
# ShopnoOS — Build Profile: shopno-os-core
# =============================================================================
# Composition:  base + core edition
# Flavor:       none (TTY only — no display server, no DE)
# Use case:     Minimal CLI, server base, container seed, netboot target
# =============================================================================

DISTRO_EDITION="core"
DISTRO_FLAVOR="none"
DISTRO_HARDWARE="generic"
DISTRO_ARCH="amd64"

# Colors
LB_COLORS="true"

# Debian base
LB_DISTRIBUTION="trixie"
LB_PARENT_DISTRIBUTION="trixie"
LB_PARENT_MIRROR_BOOTSTRAP="http://mirror.sg.gs/debian"
LB_PARENT_MIRROR_CHROOT="http://mirror.sg.gs/debian"
# Binary mirrors: what live-build writes to the shipped /etc/apt/sources.list
# (with LB_APT_ARCHIVE_AREAS, LB_SECURITY, LB_UPDATES, LB_BACKPORTS). Files in
# includes.chroot/etc/apt/sources.list are overwritten after the chroot stage.
LB_PARENT_MIRROR_BINARY="http://deb.debian.org/debian"
# LB_PARENT_MIRROR_CHROOT_SECURITY="http://security.debian.org/debian-security/"
LB_PARENT_MIRROR_BINARY_SECURITY="http://security.debian.org/debian-security"

# Image type
LB_BINARY_IMAGES="iso-hybrid"
LB_BOOTLOADERS="grub-efi grub-pc"      # dual BIOS+UEFI
LB_UEFI_SECURE_BOOT="auto"

# Boot behaviour
LB_MEMTEST="none"
LB_BOOTAPPEND_LIVE="boot=live components hostname=shopno-os-live efi_no_storage_paranoia quiet console=ttyS0,115200n8"
# console=tty0 last: d-i runs on /dev/console, so it must be the screen for
# bare-metal installs. Serial still gets kernel output; headless installs
# (tests) boot d-i directly with their own console= arguments.
LB_BOOTAPPEND_INSTALL="console=ttyS0,115200n8 console=tty0"

# Installer: debian-installer in live mode (installs the live rootfs to disk),
# text frontend only. See docs/decisions/010-core-installer-debian-installer-live.md
LB_DEBIAN_INSTALLER="live"
LB_DEBIAN_INSTALLER_GUI="false"

# Build tuning
LB_CACHE="true"
LB_CACHE_PACKAGES="true"
LB_CACHE_STAGES="bootstrap"
# LB_COMPRESSION="xz"                    # smaller ISO
# LB_DEBCONF_PRIORITY="critical"
LB_HOSTNAME="shopno-os-live"           # live session only; d-i asks at install
LB_USERNAME="liveuser"
# LB_INITRAMFS="live-boot"
# LB_INITRAMFS_COMPRESSION="xz"

# Locale / keyboard (live default; d-i asks for both at install time)
LB_LANGUAGE="en"
LB_COUNTRY="US"
LB_KEYBOARD_LAYOUTS="us"
LB_TIMEZONE="UTC"

# No desktop, no recommends bloat
LB_APT_RECOMMENDS="false"
LB_APT_SECURE="true"
LB_APT_ARCHIVE_AREAS="main contrib non-free-firmware"
LB_APT_SOURCE_ARCHIVES="false"
LB_BACKPORTS="true"
LB_SECURITY="true"
LB_UPDATES="true"

# Firmware
LB_FIRMWARE_BINARY="true"
LB_FIRMWARE_CHROOT="true"

# Architectures
LB_ARCHITECTURES="${DISTRO_ARCH}"

# Chroot options
# LB_LINUX_PACKAGES="linux-image-amd64 linux-headers-amd64"
LB_LINUX_FLAVOURS="amd64"
