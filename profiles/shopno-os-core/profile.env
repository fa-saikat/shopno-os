# =============================================================================
# ShopnoOS — Build Profile: shopno-os-core
# =============================================================================
# Composition:  base + core edition
# Flavor:       none (TTY only — no display server, no DE)
# Use case:     Minimal CLI, server base, container seed, netboot target
# =============================================================================

DISTRO_EDITION="core"
DISTRO_FLAVOR="none"
DISTRO_HARDWARE="generic"
DISTRO_ARCH="amd64"

# Colors
LB_COLORS="true"

# Debian base
LB_DISTRIBUTION="trixie"
LB_PARENT_DISTRIBUTION="trixie"
LB_PARENT_MIRROR_BOOTSTRAP="http://mirror.sg.gs/debian"
LB_PARENT_MIRROR_CHROOT="http://mirror.sg.gs/debian"
LB_PARENT_MIRROR_BINARY="http://mirror.sg.gs/debian"
# LB_PARENT_MIRROR_CHROOT_SECURITY="http://security.debian.org/debian-security/"
# LB_PARENT_MIRROR_BINARY_SECURITY="http://security.debian.org/debian-security/"

# Image type
LB_BINARY_IMAGES="iso-hybrid"
LB_BOOTLOADERS="grub-efi grub-pc"      # dual BIOS+UEFI
LB_UEFI_SECURE_BOOT="auto"

# Boot behaviour
LB_MEMTEST="none"
LB_BOOTAPPEND_LIVE="boot=live components efi_no_storage_paranoia quiet console=ttyS0,115200n8"
LB_BOOTAPPEND_INSTALL=""

# Build tuning
LB_CACHE="true"
LB_CACHE_PACKAGES="true"
LB_CACHE_STAGES="bootstrap"
# LB_COMPRESSION="xz"                    # smaller ISO
# LB_DEBCONF_PRIORITY="critical"
LB_HOSTNAME="shopno-os-live"           # overridden at install time
LB_USERNAME="liveuser"
# LB_INITRAMFS="live-boot"
# LB_INITRAMFS_COMPRESSION="xz"

# Locale / keyboard (sensible live default — overridden by installer)
LB_LANGUAGE="en"
LB_COUNTRY="US"
LB_KEYBOARD_LAYOUTS="us"
LB_TIMEZONE="UTC"

# No desktop, no recommends bloat
LB_APT_RECOMMENDS="false"
LB_APT_SECURE="true"
LB_APT_ARCHIVE_AREAS="main contrib non-free-firmware"
LB_APT_SOURCE_ARCHIVES="false"
LB_BACKPORTS="false"
LB_SECURITY="false"
LB_UPDATES="true"

# Firmware
LB_FIRMWARE_BINARY="true"
LB_FIRMWARE_CHROOT="true"

# Architectures
LB_ARCHITECTURES="${DISTRO_ARCH}"

# Chroot options
# LB_LINUX_PACKAGES="linux-image-amd64 linux-headers-amd64"
LB_LINUX_FLAVOURS="amd64"
