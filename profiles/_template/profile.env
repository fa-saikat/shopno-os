#!/usr/bin/env bash
# =============================================================================
# ShopnoOS — Profile Template: profile.env
# =============================================================================
# Purpose   : Declares the full intent of a build profile.
#             Every variable here is consumed by:
#               - scripts/build/prepare-lb-config.sh   (live-build assembly)
#               - scripts/lib/iso-name.sh              (ISO filename generation)
#               - scripts/lib/profile.sh               (validation)
#
# Usage     : Copy profiles/_template/ → profiles/shopno-os-<edition>-<flavor>/
#             Fill in the variables below. Never leave a variable unset —
#             use "none" or "generic" as explicit null values.
#
# Sourcing  : This file is sourced (not executed). Do not add logic here.
#             Logic lives in scripts/build/prepare-lb-config.sh.
#
# Law       : One profile = one ISO. No conditionals, no branching.
#             If you need a variant, make a new profile directory.
# =============================================================================

# -----------------------------------------------------------------------------
# PROFILE IDENTITY
# Human-readable name used in log output and CI job names.
# No spaces. Use hyphens.
# -----------------------------------------------------------------------------
PROFILE_NAME="shopno-os-EDITION-FLAVOR"

# -----------------------------------------------------------------------------
# COMPOSITION — What this ISO is made of
# These three variables are the core of the profile.
# They tell prepare-lb-config.sh which layer directories to assemble.
#
# DISTRO_EDITION : Must match a directory name under editions/
#                  Valid values: core | desktop | pro | edu
#                  (or any future edition added under editions/)
#
# DISTRO_FLAVOR  : Must match a directory name under flavors/
#                  Valid values: gnome | kde | xfce | minimal-x | none
#                  Use "none" for headless/server editions (e.g. core).
#
# DISTRO_HARDWARE: Must match a directory name under hardware/
#                  Valid values: generic | nvidia | amd | rpi | vm
#                  Use "generic" when no hardware-specific packages are needed.
#                  Multiple hardware overlays are NOT supported in one profile —
#                  make a separate profile (e.g. shopno-os-desktop-gnome-nvidia).
# -----------------------------------------------------------------------------
DISTRO_EDITION="EDITION"
DISTRO_FLAVOR="FLAVOR"
DISTRO_HARDWARE="generic"

# -----------------------------------------------------------------------------
# ARCHITECTURE
# The CPU architecture this ISO targets.
# Valid values: amd64 | arm64 | i386
# Note: arm64 requires an ARM-capable build host or cross-build setup.
# -----------------------------------------------------------------------------
DISTRO_ARCH="amd64"

# -----------------------------------------------------------------------------
# DEBIAN BASE
# The Debian suite this build is based on.
# Valid values: bookworm | trixie | sid
# Warning: changing this mid-release breaks reproducibility.
#          Coordinate with maintainers before switching.
# -----------------------------------------------------------------------------
LB_DISTRIBUTION="trixie"

# -----------------------------------------------------------------------------
# ISO OUTPUT FORMAT
# Controls the binary image format produced by live-build.
#
# iso-hybrid  : Bootable from USB (via dd) AND optical media. Preferred.
# iso         : Optical-media only. Rarely needed.
# hdd         : Raw disk image. Use for VM disk targets.
# tar         : Tarball. For container/bootstrap use.
# -----------------------------------------------------------------------------
LB_BINARY_IMAGES="iso-hybrid"

# -----------------------------------------------------------------------------
# BOOTLOADER STACK
# Which bootloaders to embed in the ISO.
#
# grub-efi          : UEFI boot (required for modern hardware)
# grub-legacy       : Legacy BIOS boot (for older machines)
# syslinux          : Legacy BIOS alternative (lighter, but less flexible)
#
# Most ISOs should ship both: "grub-efi syslinux"
# Secure Boot profiles: "grub-efi" only (syslinux does not support SB)
# Server/headless profiles: "grub-efi syslinux" unless SB is required
# -----------------------------------------------------------------------------
LB_BOOTLOADERS="grub-efi syslinux"

# -----------------------------------------------------------------------------
# SECURE BOOT
# Whether to embed shim-signed for Secure Boot compatibility.
# Valid values: true | false
# Requires: grub-efi in LB_BOOTLOADERS and shim-* packages in base/
# Note: Does NOT enable SB enforcement — only provides SB-compatible boot chain.
# -----------------------------------------------------------------------------
LB_UEFI_SECURE_BOOT="true"

# -----------------------------------------------------------------------------
# MEMTEST
# Whether to include a memory test utility on the ISO boot menu.
# Valid values: memtest86+ | none
# Recommendation: "none" for production slim ISOs; "memtest86+" for releases
#                 targeting end-user hardware where diagnostics are useful.
# -----------------------------------------------------------------------------
LB_MEMTEST="none"

# -----------------------------------------------------------------------------
# DEBIAN MIRROR
# The Debian mirror used during chroot package installation at build time.
# This does NOT affect the live system's sources.list — that is controlled by
# base/config/archives/shopno-os.list.binary
#
# Leave as default unless building in a region with a closer mirror
# or in an air-gapped/offline environment pointing to a local mirror.
# -----------------------------------------------------------------------------
LB_MIRROR_BOOTSTRAP="http://mirror.sg.gs/debian"
LB_MIRROR_CHROOT="http://mirror.sg.gs/debian"
LB_MIRROR_CHROOT_SECURITY="http://security.debian.org/debian-security/"
LB_MIRROR_BINARY="http://mirror.sg.gs/debian"
LB_MIRROR_BINARY_SECURITY="http://security.debian.org/debian-security/"

# -----------------------------------------------------------------------------
# APT OPTIONS
# Extra APT repository components to enable during the build.
#
# Comma-separated subset of: main contrib non-free non-free-firmware
#
# "main"                   : DFSG-free only (minimal)
# "main contrib"           : Adds contrib (e.g. some firmware installers)
# "main contrib non-free"  : Required for NVIDIA drivers, broadcom firmware, etc.
# "main contrib non-free non-free-firmware" : Full non-free (Debian 12+)
#
# Note: non-free firmware is split into its own component in Debian 12 (bookworm).
#       Always include non-free-firmware for hardware compatibility.
# -----------------------------------------------------------------------------
LB_ARCHIVE_AREAS="main contrib non-free non-free-firmware"

# -----------------------------------------------------------------------------
# LIVE SYSTEM HOSTNAME
# Default hostname set in the live (pre-install) session.
# Post-install hostname is handled by Calamares.
# Sourced from brand/identity/name.env at build time via scripts/lib/brand.sh.
# Set this only to override the brand default for a specific profile.
# Leave empty to inherit from brand/identity/name.env (DISTRO_ID).
# -----------------------------------------------------------------------------
LB_HOSTNAME=""

# -----------------------------------------------------------------------------
# LIVE SYSTEM USERNAME
# The default live-session user (autologin account).
# Typically matches the distro ID. Calamares handles post-install users.
# Leave empty to inherit from brand/identity/name.env.
# -----------------------------------------------------------------------------
LB_USERNAME=""

# -----------------------------------------------------------------------------
# COMPRESSION
# Squashfs compression algorithm used for the rootfs.
#
# zstd    : Fastest decompression. Best for live-use ISOs. Preferred.
# xz      : Smallest size. Slowest decompression. Good for release ISOs.
# lz4     : Even faster than zstd but larger. For development iteration.
# gzip    : Legacy. Avoid unless compatibility is required.
#
# Recommendation:
#   Dev builds    → lz4  (fast rebuild + boot)
#   Release ISOs  → zstd (balance of speed and size)
#   Archival      → xz   (smallest possible)
# -----------------------------------------------------------------------------
LB_COMPRESSION="zstd"

# -----------------------------------------------------------------------------
# ISO VOLUME ID
# The volume label embedded in the ISO filesystem.
# Visible when the ISO is mounted. Max 32 characters, no special chars.
# Sourced from brand/identity/name.env at build time by default.
# Override here only for profile-specific labels.
# Example: "ShopnoOS 1.0 Desktop GNOME"
# Leave empty to auto-generate from brand vars + DISTRO_EDITION + DISTRO_FLAVOR.
# -----------------------------------------------------------------------------
LB_ISO_VOLUME=""

# -----------------------------------------------------------------------------
# BUILD CACHE BEHAVIOR
# Controls live-build's caching of downloaded packages.
#
# true  : Enables package cache (recommended). Speeds up repeated builds.
#         Cache lives in build/${PROFILE_NAME}/cache/
# false : Disables cache. Use only in CI environments with external caching.
# -----------------------------------------------------------------------------
LB_CACHE="true"

# -----------------------------------------------------------------------------
# CHROOT FILESYSTEM
# The filesystem type used for the chroot during the build.
# Valid values: none | union
# "none" is standard for most builds.
# "union" uses overlay/union mounts (advanced — rarely needed).
# -----------------------------------------------------------------------------
LB_CHROOT_FILESYSTEM="none"

# -----------------------------------------------------------------------------
# BINARY FILESYSTEM
# The filesystem embedded in the ISO for the live root.
# squashfs is always used for live ISOs. Do not change unless you know why.
# -----------------------------------------------------------------------------
LB_BINARY_FILESYSTEM="squashfs"

# -----------------------------------------------------------------------------
# INITRAMFS COMPRESSION
# Compression for the initrd/initramfs embedded in the ISO.
# Valid values: gzip | lz4 | xz | zstd | bzip2 | lzma | lzop | none
# Recommendation: zstd for speed, xz for smallest size.
# Must match what the target kernel supports — bookworm kernels support all of the above.
# -----------------------------------------------------------------------------
LB_INITRAMFS_COMPRESSION="zstd"

# -----------------------------------------------------------------------------
# LOCALE & KEYBOARD
# Default locale and keyboard layout for the live session.
# Post-install locale is set by Calamares based on user selection.
# Multiple locales can be space-separated. First entry is the default.
# -----------------------------------------------------------------------------
LB_LANGUAGE="en"
LB_LOCALE="en_US.UTF-8"
LB_KEYBOARD_LAYOUTS="us"
LB_KEYBOARD_VARIANTS=""

# -----------------------------------------------------------------------------
# TIMEZONE
# Default timezone for the live session.
# Format: Region/City (e.g. "Asia/Dhaka", "America/New_York", "Europe/London")
# Post-install timezone is handled by Calamares.
# -----------------------------------------------------------------------------
LB_TIMEZONE="UTC"

# -----------------------------------------------------------------------------
# PROFILE METADATA (informational — used by CI and tooling, not lb_config)
# These do not affect the build output directly.
# -----------------------------------------------------------------------------

# One-line description of this profile's purpose.
# Shown in `./scripts/build/build.sh --list` output.
PROFILE_DESCRIPTION="FILL IN: e.g. Desktop edition with GNOME flavor for amd64"

# Maintainer of this profile (for CI notifications and CHANGELOG attribution)
PROFILE_MAINTAINER="ShopnoOS Team"

# Whether this profile is enabled in CI automated builds.
# Set to "false" for WIP or experimental profiles.
# Valid values: true | false
PROFILE_CI_ENABLED="false"

# Whether this profile is a release candidate profile.
# Release profiles are signed and published by release/sign-iso.sh.
# Valid values: true | false
PROFILE_RELEASE="false"
