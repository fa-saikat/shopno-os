#!/usr/bin/env bash
# =============================================================================
# Install welcome app for gaming edition via deb package
# Track: https://github.com/fa-saikat/shopno-os/issues/9
# =============================================================================
set -euo pipefail

PACKAGE_NAME="jadupc-welcome"
PACKAGE_VERSION="1.1.0-1"
PACKAGE_ARCH="amd64"
DOWNLOAD_URL="https://dev.jadupc.com/builds/deb/${PACKAGE_NAME}/${PACKAGE_NAME}_${PACKAGE_VERSION}_${PACKAGE_ARCH}.deb"
DEB_FILE="/tmp/${PACKAGE_NAME}_${PACKAGE_VERSION}.deb"

echo "[ShopnoOS] Installing ${PACKAGE_NAME} ${PACKAGE_VERSION} from upstream..."

wget --quiet --show-progress \
     --timeout=60 \
     --tries=3 \
     -O "${DEB_FILE}" \
     "${DOWNLOAD_URL}"

dpkg -i "${DEB_FILE}" || apt-get install -f -y

rm -f "${DEB_FILE}"

echo "[ShopnoOS] ${PACKAGE_NAME} installed successfully."
