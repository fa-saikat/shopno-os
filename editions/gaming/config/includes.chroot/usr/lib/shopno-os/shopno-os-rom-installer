#!/usr/bin/env bash

set -Eeuo pipefail

APP_PATH="/usr/local/share/shopno-os-rom-installer/retropie-rom-installer.py"
PYTHON="/usr/bin/python3"
LOG_FILE="/var/log/rom-installer.log"
APP_NAME="ShopnoOS ROM Installer"

log() {
    echo "[$(date '+%F %T')] $*" | tee -a "$LOG_FILE"
}

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$APP_NAME" "$1"
    fi
}

if [[ -f "$APP_PATH" ]]; then
    if [[ -x "$PYTHON" ]]; then
#         log "Launching ROM installer..."
        "$PYTHON" "$APP_PATH"
        EXIT_CODE=$?

        if [[ $EXIT_CODE -ne 0 ]]; then
            log "ROM installer exited with error code: $EXIT_CODE"
            notify "ROM installer failed (exit code: $EXIT_CODE)"
            exit $EXIT_CODE
        else
            log "ROM installer finished successfully."
        fi
    else
#         log "Python not found at $PYTHON"
        notify "Python interpreter not found!"
        exit 1
    fi
else
    log "ROM Installer app not found at path: $APP_PATH"
    notify "ROM Installer app not found!"
    exit 1
fi
