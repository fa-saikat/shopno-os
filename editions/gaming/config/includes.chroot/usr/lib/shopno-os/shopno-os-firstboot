#!/bin/bash
# /usr/lib/shopno-os/shopno-os-firstboot

set -euo pipefail
set -x

# Find the real user (not root, not system accounts)
NONROOT_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' | head -1)
NONROOT_HOME=$(getent passwd "${NONROOT_USER}" | cut -d: -f6)

if [[ -z "${NONROOT_USER}" ]]; then
    echo "shopno-os-firstboot: Non root user not found, aborting" >&2
    exit 1
fi

# Symlink RetroPie directories into user home
if ln -sfn /opt/RetroPie  "${NONROOT_HOME}/"; then
    echo "Symlink of RetroPie directory is created."
else
    echo "Symlink creation failed."
    exit 1
fi

ln -sfn /opt/retropie/configs/all/emulationstation "${NONROOT_HOME}/.emulationstation"
chown -Rh "${NONROOT_USER}:${NONROOT_USER}" /opt/retropie/configs/all/emulationstation

ln -sfn /opt/retropie/configs/all/retroarch "${NONROOT_HOME}/.config/retroarch"
# chown -Rh "${NONROOT_USER}:${NONROOT_USER}" /opt/retropie/configs/all/retroarch

chown -Rh "${NONROOT_USER}:${NONROOT_USER}" /opt/RetroPie

# mkdir -p "${NONROOT_HOME}/RetroPie"
# ln -sfn /opt/retropie/roms  "${NONROOT_HOME}/RetroPie/roms"
# ln -sfn /opt/retropie/BIOS  "${NONROOT_HOME}/RetroPie/BIOS"
# ln -sfn /opt/retropie/retropiemenu  "${NONROOT_HOME}/RetroPie/retropiemenu"
# chown -h "${NONROOT_USER}:${NONROOT_USER}" \
#     "${NONROOT_HOME}/RetroPie" \
#     "${NONROOT_HOME}/RetroPie/roms" \
#     "${NONROOT_HOME}/RetroPie/BIOS" \
#     "${NONROOT_HOME}/RetroPie/retropiemenu"

# Set up welcome app config dir (shopno-shell shows the welcome app once
# while this flag file exists)
mkdir -p "${NONROOT_HOME}/.config/jadupc"
touch "${NONROOT_HOME}/.config/jadupc/welcome-autostart"
chown -R "${NONROOT_USER}:${NONROOT_USER}" "${NONROOT_HOME}/.config/jadupc"

# Service will not run again
rm -f /etc/gaming-firstboot-pending

echo "shopno-os-firstboot: setup complete for ${NONROOT_USER}"
