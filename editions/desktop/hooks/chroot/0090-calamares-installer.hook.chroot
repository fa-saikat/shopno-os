#!/usr/bin/env bash

set -e

# Enable Calamares installer debug mode
sed -i -e 's|^ *pkexec calamares|pkexec calamares -d|' /usr/bin/calamares-install-debian

# Rename Calamares installer desktop name and icon 
sed -i -e 's|Debian|ShopnoOS|g' /usr/share/applications/calamares-install-debian.desktop
sed -i -e 's|^ *Icon=install-debian|Icon=/usr/share/icons/shopno-os.png|' /usr/share/applications/calamares-install-debian.desktop
