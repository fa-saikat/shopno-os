#!/usr/bin/env bash
# =============================================================================
# Install sysinfo-viewer for desktop edition via deb package
# =============================================================================
set -euo pipefail

PACKAGE_NAME="sysinfo-viewer"
PACKAGE_VERSION="2.1.0"
PACKAGE_ARCH="amd64"
DEB_VERSION="2.1.0-1"
DOWNLOAD_URL="https://github.com/fa-saikat/${PACKAGE_NAME}/releases/download/v${PACKAGE_VERSION}/${PACKAGE_NAME}_${DEB_VERSION}_${PACKAGE_ARCH}.deb"
DEB_FILE="/tmp/${PACKAGE_NAME}_${DEB_VERSION}.deb"

echo "[hook-9063] Installing ${PACKAGE_NAME} ${PACKAGE_VERSION} from upstream..."

wget --quiet --show-progress \
     --timeout=60 \
     --tries=3 \
     -O "${DEB_FILE}" \
     "${DOWNLOAD_URL}"

dpkg -i "${DEB_FILE}" || apt-get install -f -y

rm -f "${DEB_FILE}"

echo "[hook-9063] ${PACKAGE_NAME} installed successfully."
