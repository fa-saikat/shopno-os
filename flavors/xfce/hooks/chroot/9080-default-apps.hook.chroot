#!/usr/bin/env bash
# =============================================================================
# flavors/xfce/hooks/chroot/9080-default-apps.hook.chroot
#
# Pick a default app for every file type our apps can open.
#
# With no mimeapps.list, GIO takes the first app in mimeinfo.cache, which is
# effectively alphabetical: com.google.Chrome beats ristretto for images and
# evince for PDFs, and archive managers win types nobody claimed explicitly.
#
# Each app in PREFERRED becomes the default for every MIME type its .desktop
# file declares, unless an app earlier in the list already took that type.
# Generated at build time so types added by package updates are covered;
# apps that aren't installed are skipped.
#
# Output is /etc/xdg/mimeapps.list: below the user's ~/.config/mimeapps.list,
# so "Set as default" in Thunar still wins. Sorts after the edition's
# 0020-external-apps hook, so Chrome and OnlyOffice are already installed.
# =============================================================================
set -euo pipefail

ROOT=${ROOT:-}   # run against an unpacked tree instead of / (testing)
OUT="$ROOT/etc/xdg/mimeapps.list"

# Highest priority first. Order only matters where two apps claim a type.
PREFERRED=(
    thunar.desktop                      # folders
    gdebi.desktop                       # .deb, before xarchiver
    org.xfce.ristretto.desktop          # images, before evince, chrome, gimp
    org.gnome.Evince.desktop            # pdf, ps, djvu, comics, before onlyoffice
    onlyoffice-desktopeditors.desktop   # office documents, before xarchiver
    vlc.desktop                         # audio, video
    mpv.desktop
    org.xfce.mousepad.desktop           # text/plain (subtypes fall back to it)
    google-chrome.desktop               # html, http(s)
    xarchiver.desktop                   # archives
    gimp.desktop                        # xcf, psd and other editing formats
    org.inkscape.Inkscape.desktop
    geany.desktop                       # source code
)

# Same lookup order as XDG_DATA_DIRS: /usr/local overrides /usr.
desktop_file() {
    local d
    for d in "$ROOT/usr/local/share/applications" "$ROOT/usr/share/applications"; do
        [ -f "$d/$1" ] && { echo "$d/$1"; return 0; }
    done
    return 1
}

# MIME types from the [Desktop Entry] group; nothing if Hidden=true.
mime_types() {
    awk -F= '
        /^\[/                         { main = ($0 == "[Desktop Entry]"); next }
        main && $1 == "Hidden" && $2 == "true" { exit }
        main && $1 == "MimeType"      { print $2 }
    ' "$1" | tr ';' '\n' | grep -v '^$' || true
}

declare -A default=()
for app in "${PREFERRED[@]}"; do
    file=$(desktop_file "$app") || { echo "default-apps: $app not installed, skipping"; continue; }
    while read -r mime; do
        [ -n "${default[$mime]:-}" ] || default[$mime]=$app
    done < <(mime_types "$file")
done

install -d -m 0755 "$(dirname "$OUT")"
{
    echo "# Generated at build time by 9080-default-apps.hook.chroot"
    echo "[Default Applications]"
    for mime in "${!default[@]}"; do
        echo "$mime=${default[$mime]};"
    done | LC_ALL=C sort
} > "$OUT"
chmod 0644 "$OUT"

echo "default-apps: ${#default[@]} types written to $OUT"
