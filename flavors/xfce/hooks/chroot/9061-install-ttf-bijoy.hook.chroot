#!/usr/bin/env bash
# =============================================================================
# Install ttf-bijoy (Bangla font) from direct download URL
# TODO: Replace with 'ttf-bijoy' from ShopnoOS apt repo once packaged
# Track: https://github.com/fa-saikat/shopno-os/issues/2
# =============================================================================
set -euo pipefail

PACKAGE_NAME="ttf-bijoy"
PACKAGE_VERSION="1.0.0-2"
DOWNLOAD_URL="https://dev.jadupc.com/builds/bijoy/${PACKAGE_NAME}_${PACKAGE_VERSION}_all.deb"
DEB_FILE="/tmp/${PACKAGE_NAME}_${PACKAGE_VERSION}.deb"

echo "[ShopnoOS] Installing ${PACKAGE_NAME} ${PACKAGE_VERSION} from upstream..."

wget --quiet --show-progress \
     --timeout=60 \
     --tries=3 \
     -O "${DEB_FILE}" \
     "${DOWNLOAD_URL}"

dpkg -i "${DEB_FILE}" || apt-get install -f -y

rm -f "${DEB_FILE}"

echo "[ShopnoOS] ${PACKAGE_NAME} installed successfully."
