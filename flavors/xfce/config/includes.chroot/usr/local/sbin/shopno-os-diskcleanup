#!/bin/bash

# Disk Space Cleanup Script
# Automatically cleans cache and temporary files when disk space is low

if [[ $EUID -ne 0 ]]; then
    echo "This script requires root privilage"
    exit 1
fi

THRESHOLD=85
LOG_FILE="/var/log/disk-cleanup.log"
PARTITION="/" 

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee "$LOG_FILE"
}

get_disk_usage() {
    df -h "$PARTITION" | awk 'NR==2 {print $5}' | sed 's/%//'
}

cleanup_system() {
    log_message "Starting cleanup process..."
    
    if command -v apt &> /dev/null; then
        log_message "Cleaning apt cache..."
        apt clean
        apt autoclean
        apt autoremove -y
    fi
    
    if command -v journalctl &> /dev/null; then
        log_message "Cleaning old journal logs..."
        journalctl --vacuum-time=3d
    fi
    
    log_message "Cleaning thumbnail cache..."
    rm -rf /home/*/.cache/*
    
    log_message "Cleaning old temporary files..."
    find /tmp -type f -atime +7 -delete 2>/dev/null
    find /var/tmp -type f -atime +7 -delete 2>/dev/null
    
    log_message "Cleaning old log files..."
    find /var/log -type f -name "*.log" -mtime +30 -delete 2>/dev/null
    find /var/log -type f -name "*.gz" -mtime +30 -delete 2>/dev/null
    rm -rf /var/log.hdd
    
    log_message "Cleaning user cache directories..."
    rm -rf /home/*/.cache/* 2>/dev/null
    rm -rf /root/.cache/* 2>/dev/null
    rm -rf /home/*/.xsession-errors.old 2>/dev/null
    
    log_message "Cleaning browser..."
    rm -rf /home/*/.config/chromium-backup* 2>/dev/null
    rm -rf /root/.config/chromium-backup* 2>/dev/null
    
    log_message "Cleanup completed."
}

CURRENT_USAGE=$(get_disk_usage)

log_message "Current disk usage: ${CURRENT_USAGE}%"

if [ "$CURRENT_USAGE" -gt "$THRESHOLD" ]; then
    log_message "Disk usage (${CURRENT_USAGE}%) exceeds threshold (${THRESHOLD}%). Starting cleanup..."
    
    BEFORE_USAGE=$CURRENT_USAGE
    cleanup_system
    AFTER_USAGE=$(get_disk_usage)
    
    FREED=$((BEFORE_USAGE - AFTER_USAGE))
    log_message "Cleanup finished. Freed ${FREED}% disk space. Current usage: ${AFTER_USAGE}%"
else
    log_message "Disk usage is below threshold. No cleanup needed."
fi

