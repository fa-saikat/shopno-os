# =============================================================================
# secrets/signing.env
# ShopnoOS — ISO Signing Key
#
# WHAT THIS IS:
#   GPG key used to sign built ISOs and their checksum manifests.
#   Sourced by scripts/release/sign-iso.sh via scripts/build/build.sh.
#
# HOW TO GET YOUR KEY ID:
#   gpg --list-secret-keys --keyid-format LONG
#   The key ID is the 40-character fingerprint shown below the sec line.
#
# HOW TO GENERATE A NEW KEY (if you don't have one):
#   gpg --full-generate-key
#   Recommended: RSA 4096, expiry 10 years, name "ShopnoOS Release Key"
#
# FOR CI (GitHub Actions / Forgejo):
#   Export the private key:
#     gpg --export-secret-keys --armor <KEY_ID>
#   Store the output as a repository secret: OS_GPG_PRIVATE_KEY
#   In the workflow, import it before building:
#     echo "$OS_GPG_PRIVATE_KEY" | gpg --import
#   Then set OS_GPG_KEY and OS_GPG_BATCH=1
#
# WARNING: Never commit secrets/signing.env — it is gitignored.
# =============================================================================

# GPG key ID or fingerprint to sign ISOs with (required)
OS_GPG_KEY=YOUR_GPG_KEY_FINGERPRINT_HERE

# Set to 1 for non-interactive/CI signing (uses gpg-agent, no passphrase prompt)
OS_GPG_BATCH=0
