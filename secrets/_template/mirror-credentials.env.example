# =============================================================================
# secrets/mirror-credentials.env
# ShopnoOS — Release Mirror / Upload Credentials
#
# WHAT THIS IS:
#   Credentials for uploading signed ISOs and checksum manifests to the
#   release mirror or distribution server.
#   Sourced by scripts/release/publish.sh.
#
# SUPPORTED UPLOAD METHODS:
#   rsync+ssh   — recommended for self-hosted mirrors
#   sftp        — alternative for hosted storage
#   s3          — for S3-compatible object storage (e.g. Cloudflare R2, MinIO)
#
# PICK ONE METHOD and fill in the relevant block. Leave others blank.
#
# WARNING: Never commit secrets/mirror-credentials.env — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Method: rsync + SSH (recommended)
# publish.sh will run:
#   rsync -avz --progress <iso-artifacts> $OS_MIRROR_USER@$OS_MIRROR_HOST:$OS_MIRROR_PATH
# -----------------------------------------------------------------------------
OS_MIRROR_HOST=
OS_MIRROR_USER=
OS_MIRROR_PATH=

# SSH key to use for rsync (defaults to ~/.ssh/id_ed25519 if blank)
OS_MIRROR_SSH_KEY=

# -----------------------------------------------------------------------------
# Method: S3-compatible object storage
# publish.sh will run: aws s3 cp / rclone copy
# -----------------------------------------------------------------------------
OS_S3_BUCKET=
OS_S3_ENDPOINT=
OS_S3_ACCESS_KEY=
OS_S3_SECRET_KEY=
OS_S3_REGION=auto
