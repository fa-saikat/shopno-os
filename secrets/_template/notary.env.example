# =============================================================================
# secrets/notary.env
# ShopnoOS — Secure Boot / MOK Signing Credentials
#
# WHAT THIS IS:
#   Machine Owner Key (MOK) credentials for signing the bootloader and kernel
#   modules to support Secure Boot on UEFI systems.
#   Sourced by scripts/build/build.sh when OS_SECUREBOOT=1 is set.
#
# WHY THIS EXISTS:
#   UEFI Secure Boot requires that bootloaders and kernel modules be signed
#   with a trusted key. Without this, Secure Boot users must either disable
#   it or manually enroll your key — a poor user experience.
#   This key is separate from ISO signing and APT repo signing.
#
# HOW TO GENERATE A MOK KEY PAIR:
#   openssl req -new -x509 -newkey rsa:2048 -days 3650 -subj "/CN=ShopnoOS MOK/" \
#     -keyout secrets/mok.key -out secrets/mok.crt -nodes
#   Keep mok.key secret (gitignored). mok.crt is the public cert — can be committed
#   to brand/assets/ for users to enroll manually if needed.
#
# HOW IT IS USED:
#   sbsign --key $OS_MOK_KEY --cert $OS_MOK_CERT --output signed.efi unsigned.efi
#
# FOR CI:
#   Store mok.key contents as a repository secret: OS_MOK_KEY_CONTENTS
#   Write it to a temp file in the workflow before building:
#     echo "$OS_MOK_KEY_CONTENTS" > /tmp/mok.key
#     export OS_MOK_KEY=/tmp/mok.key
#
# WARNING: Never commit secrets/notary.env or secrets/mok.key — both are gitignored.
# =============================================================================

# Enable Secure Boot signing during build (set to 1 to activate)
OS_SECUREBOOT=0

# Path to the MOK private key (PEM format)
OS_MOK_KEY=secrets/mok.key

# Path to the MOK public certificate (PEM format)
OS_MOK_CERT=secrets/mok.crt
