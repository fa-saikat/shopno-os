# =============================================================================
# secrets/github-token.env
# ShopnoOS — GitHub / Forgejo API Token
#
# WHAT THIS IS:
#   Personal access token for automating GitHub/Forgejo release management.
#   Sourced by scripts/release/publish.sh and scripts/release/changelog-gen.sh.
#
# WHAT IT IS USED FOR:
#   - Creating GitHub Releases programmatically after a build
#   - Uploading ISO artifacts as release assets
#   - Auto-generating changelogs from merged PRs / commit history
#   - Triggering downstream workflows via repository_dispatch
#
# HOW TO GENERATE (GitHub):
#   GitHub → Settings → Developer Settings → Personal Access Tokens → Fine-grained
#   Required permissions:
#     Contents: Read and Write   (to create releases and upload assets)
#     Metadata: Read             (always required)
#
# HOW TO GENERATE (Forgejo):
#   Forgejo → Settings → Applications → Generate Token
#   Required scope: repo (full)
#
# FOR CI:
#   Do NOT put a real token here for CI — use the built-in GITHUB_TOKEN secret
#   that GitHub Actions provides automatically. This file is only needed for
#   running release scripts locally from a developer machine.
#
# TOKEN ROTATION:
#   Treat this like a password. Rotate it if it is ever exposed.
#   Revoke at: https://github.com/settings/tokens
#
# WARNING: Never commit secrets/github-token.env — it is gitignored.
# =============================================================================

# GitHub or Forgejo API token (required by publish.sh and changelog-gen.sh)
OS_GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# Repository target (owner/repo format)
OS_GITHUB_REPO=YOUR_GITHUB_REPO

# API base URL — change this if using Forgejo or GitHub Enterprise
OS_GITHUB_API_URL=https://api.github.com
