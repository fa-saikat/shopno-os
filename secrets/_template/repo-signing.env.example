# =============================================================================
# secrets/repo-signing.env
# ShopnoOS — APT Repository Signing Key
#
# WHAT THIS IS:
#   GPG key used to sign the APT package repository (Packages, Release files).
#   This is SEPARATE from the ISO signing key in signing.env.
#   Sourced by scripts/release/publish.sh when updating the APT repo.
#
# WHY SEPARATE FROM signing.env:
#   ISO signing proves the ISO came from you.
#   APT repo signing proves packages haven't been tampered with at apt-get time.
#   They serve different trust chains and should be rotatable independently.
#
# HOW THIS KEY IS USED:
#   The public half is already deployed into the ISO at build time:
#     base/config/archives/shopno-os.key.chroot   ← trusted during build
#     base/config/archives/shopno-os.key.binary   ← deployed into live system
#   The private half (this file) is only ever used on the release/build machine.
#
# HOW TO GENERATE:
#   gpg --full-generate-key
#   Recommended: RSA 4096, name "ShopnoOS Archive Signing Key"
#   Then export the public key:
#     gpg --export --armor <KEY_ID> > base/config/archives/shopno-os.key.chroot
#     cp base/config/archives/shopno-os.key.chroot base/config/archives/shopno-os.key.binary
#
# FOR CI:
#   Same pattern as signing.env — store private key as a repository secret
#   and import before running publish.sh.
#
# WARNING: Never commit secrets/repo-signing.env — it is gitignored.
# =============================================================================

# GPG key ID or fingerprint for APT repo signing (required by publish.sh)
OS_REPO_GPG_KEY=YOUR_REPO_GPG_KEY_FINGERPRINT_HERE

# Set to 1 for non-interactive/CI signing
OS_REPO_GPG_BATCH=0
