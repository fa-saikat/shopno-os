#!/usr/bin/env bash
#
# shopno-clean-system.sh  -- safer conservative cleaner for imaging
#
# Defaults are conservative: no system or user SSH keys removed unless explicit flags passed.
# Creates backups under /var/backups/shopno-clean/<timestamp>/ for easy restore.
#
# Usage:
#   sudo bash shopno-clean-system.sh [--dry-run] [--zero-fill] [--preserve-users=user1,user2]
#                                    [--remove-system-ssh] [--remove-user-ssh] [--no-auto-fix-ssh]
#
# Flags:
#   --dry-run             : show actions but do not perform destructive changes
#   --zero-fill           : zero-fill free space (may increase flash wear)
#   --preserve-users=...  : comma-separated homes to skip entirely
#   --remove-system-ssh   : explicitly remove /etc/ssh/ssh_host_* (dangerous; opt-in)
#   --remove-user-ssh     : explicitly remove users' ~/.ssh (opt-in)
#   --no-auto-fix-ssh     : do not attempt auto reinstall/repair of openssh-server if SSH fails
#   --help|-h             : show this header
#
set -euo pipefail

# --------- defaults ----------
DRY_RUN=false
ZERO_FILL=false
PRESERVE_USERS=()
REMOVE_SYSTEM_SSH=false
REMOVE_USER_SSH=false
AUTO_FIX_SSH=true

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="/var/backups/shopno-os-sysclean/${TIMESTAMP}"
LOGFILE="/var/log/shopno-os-sysclean-${TIMESTAMP}.log"

# --------- helpers -----------
log() { echo "[$(date +'%F %T')] $*" | tee -a "$LOGFILE"; }
run() {
  if [ "$DRY_RUN" = true ]; then
    echo "[DRY-RUN] $*"
  else
    echo "[RUN] $*" | tee -a "$LOGFILE"
    eval "$@"
  fi
}
is_preserved_user() {
  local u="$1"
  for v in "${PRESERVE_USERS[@]}"; do
    if [ "$u" = "$v" ]; then return 0; fi
  done
  return 1
}

# --------- parse args ----------
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --zero-fill) ZERO_FILL=true ;;
    --preserve-users=*) IFS=',' read -r -a PRESERVE_USERS <<< "${arg#*=}" ;;
    --remove-system-ssh) REMOVE_SYSTEM_SSH=true ;;
    --remove-user-ssh) REMOVE_USER_SSH=true ;;
    --no-auto-fix-ssh) AUTO_FIX_SSH=false ;;
    --help|-h)
      sed -n '1,200p' "$0"
      exit 0
      ;;
    *) echo "Unknown arg: $arg"; exit 2 ;;
  esac
done

# --------- require root ----------
if [ "$(id -u)" -ne 0 ]; then
  echo "Error: must run as root (sudo)."
  exit 1
fi

# Ensure /var/backups exists and logfile
if [ "$DRY_RUN" = false ]; then
  mkdir -p "$BACKUP_DIR"
  touch "$LOGFILE"
  chmod 0644 "$LOGFILE"
fi

log "Starting shopno-clean-system.sh (DRY_RUN=$DRY_RUN ZERO_FILL=$ZERO_FILL REMOVE_SYSTEM_SSH=$REMOVE_SYSTEM_SSH REMOVE_USER_SSH=$REMOVE_USER_SSH PRESERVE_USERS=${PRESERVE_USERS[*]})"
echo

# Backup helper
backup_file_or_dir() {
  local src="$1"
  if [ -e "$src" ]; then
    if [ "$DRY_RUN" = true ]; then
      echo "[DRY-RUN] would backup $src to $BACKUP_DIR"
    else
      mkdir -p "$BACKUP_DIR"
      # try to preserve attributes
      tar --warning=no-file-changed -czf "${BACKUP_DIR}/backup-$(basename "$src").tar.gz" -C / "$(realpath --relative-to=/ "$src")" 2>/dev/null || cp -a "$src" "${BACKUP_DIR}/" 2>/dev/null || true
      log "Backed up $src -> ${BACKUP_DIR}"
    fi
  fi
}

# Safety: do not remove SSH keys unless requested. Back them up if present.
echo; log "-> Backing up critical files (apt lists, /etc/ssh, machine-id, /var/log)..."
backup_file_or_dir "/var/lib/apt/lists"
backup_file_or_dir "/etc/ssh"
backup_file_or_dir "/etc/machine-id"
backup_file_or_dir "/var/lib/dbus/machine-id"
backup_file_or_dir "/var/log"

# 1) APT / package caches
echo; log "-> Cleaning apt caches and package leftovers..."
run "apt-get clean || true"
run "apt-get autoclean || true"
run "apt-get autoremove --purge -y || true"
run "rm -rf /var/lib/apt/lists/* || true"
run "rm -rf /var/cache/apt/archives/* || true"

# 2) Temporary directories
echo; log "-> Clearing /tmp and /var/tmp..."
run "rm -rf /tmp/* /tmp/.[!.]* 2>/dev/null || true"
run "rm -rf /var/tmp/* /var/tmp/.[!.]* 2>/dev/null || true"

# 3) System caches
echo; log "-> Clearing /var/cache (files only)"
run "find /var/cache -mindepth 1 -maxdepth 4 -type f -delete || true"
run "find /var/cache -type d -empty -delete || true"

# 4) Logs and journal (backup done earlier)
echo; log "-> Rotating and vacuuming journal (keeps dir structure) and trimming logs"
run "journalctl --rotate || true"
run "journalctl --vacuum-time=1s || true"
# trim logs but avoid removing directories required by services
run "find /var/log -type f -exec truncate -s 0 {} + || true"

# 5) Machine-specific IDs (backup was taken)
echo; log "-> Resetting machine-id (will be regenerated on first boot)"
if [ "$DRY_RUN" = true ]; then
  echo "[DRY-RUN] would remove /etc/machine-id and /var/lib/dbus/machine-id and touch /etc/machine-id"
else
  rm -f /etc/machine-id || true
  rm -f /var/lib/dbus/machine-id || true
  # leave blank file for services; systemd will populate on boot
  : > /etc/machine-id
  ln -sf /etc/machine-id /var/lib/dbus/machine-id || true
  log "Machine-id reset; original backed up to $BACKUP_DIR"
fi

# 6) SSH keys: system keys only removed if explicit flag
if [ "$REMOVE_SYSTEM_SSH" = true ]; then
  echo; log "-> Removing system SSH host keys (requested by flag)"
  backup_file_or_dir "/etc/ssh"
#   run "rm -f /etc/ssh/ssh_host_* || true"
else
  log "-> Preserving system SSH host keys (pass --remove-system-ssh to remove)"
fi

# 7) User-specific cleaning: conservative by default; remove ~/.ssh only if requested
echo; log "-> Cleaning user homes (histories, caches, thumbnails). Preserved homes: ${PRESERVE_USERS[*]}"
for home in /home/*/; do
  [ -d "$home" ] || continue
  user=$(basename "$home")
  if is_preserved_user "$user"; then
    log "[SKIP] preserving entire home for user: $user"
    continue
  fi

  run "rm -f \"$home/.bash_history\" || true"
  run "rm -f \"$home/.sh_history\" || true"
  run "rm -f \"$home/.zsh_history\" || true"
  run "rm -rf \"$home/.cache\" || true"
  run "runuser -u \"$user\" -- bash -lc 'rm -rf ~/.local/share/Trash/*' 2>/dev/null || true"
  run "rm -rf \"$home/.thumbnails\" || true"
  run "runuser -u \"$user\" -- bash -lc 'rm -f ~/.recently-used.xbel' 2>/dev/null || true"
  run "rm -rf \"$home/.mozilla\"/*/cache2 2>/dev/null || true"
  run "rm -rf \"$home/.config/chromium\" \"$home/.config/chromium\" 2>/dev/null || true"
  run "rm -rf \"$home/.cache/google-chrome\" \"$home/.cache/chromium\" 2>/dev/null || true"


  if [ "$REMOVE_USER_SSH" = true ]; then
    log "-> Removing $home/.ssh (requested)"
    backup_file_or_dir "$home/.ssh"
 #    run "rm -rf \"$home/.ssh\" || true"
  else
    log "-> Preserving $home/.ssh (pass --remove-user-ssh to delete)"
  fi
done

# root home cleanup (do not remove /root/.ssh unless explicit flag)
log "-> Cleaning /root (histories and caches)"
run "rm -f /root/.bash_history || true"
run "rm -rf /root/.cache || true"
if [ "$REMOVE_USER_SSH" = true ]; then
  backup_file_or_dir "/root/.ssh"
#   run "rm -rf /root/.ssh || true"
else
  log "-> Preserving /root/.ssh"
fi

run "rm -rf /root/.config/chromium"

# 8) Remove persistent network/connection files
echo; log "-> Removing persistent network & NetworkManager connection files (backed up)"
backup_file_or_dir "/etc/udev/rules.d/70-persistent-net.rules"
run "rm -f /etc/udev/rules.d/70-persistent-net.rules || true"
backup_file_or_dir "/etc/NetworkManager/system-connections"
run "rm -f /etc/NetworkManager/system-connections/* 2>/dev/null || true"
run "rm -f /var/lib/NetworkManager/* 2>/dev/null || true"

# 9) dpkg/apt/dpkg leftovers
echo; log "-> Cleaning dpkg/dpkg caches/backups"
backup_file_or_dir "/var/lib/dpkg"
run "rm -rf /var/lib/dpkg/*-old || true"
run "rm -rf /var/backups/* || true"

# 10) coredumps, local state
echo; log "-> Clearing coredumps and /var/tmp"
run "rm -rf /var/lib/systemd/coredump || true"
run "rm -rf /var/tmp/* || true"

# 11) truncate man/locale caches
echo; log "-> Trimming man/locale caches"
run "rm -rf /var/cache/man/* || true"
run "rm -rf /var/cache/locale/* || true"

# 12) clear in-memory history
echo; log "-> Clearing in-memory shell history"
if [ "$DRY_RUN" = false ]; then
  history -c || true
fi

# 13) Optional zero-fill
if [ "$ZERO_FILL" = true ]; then
  echo; log "-> Zero-filling free space (careful: increases flash wear)"
  run "dd if=/dev/zero of=/zero.fill bs=1M || true"
  run "sync || true"
  run "rm -f /zero.fill || true"
  run "sync || true"
fi

# 14) SSH validation & safe-repair (only if script changed keys or machine-id)
ssh_service_name="ssh"
if systemctl list-units --type=service --all | grep -q '\bsshd.service\b'; then
  ssh_service_name="sshd"
fi

# If we removed system/user SSH keys, validate sshd config and attempt safe restart
if [ "$REMOVE_SYSTEM_SSH" = true ] || [ "$REMOVE_USER_SSH" = true ]; then
  echo; log "-> SSH keys were changed; validating sshd configuration and attempting safe restart"
  if [ "$DRY_RUN" = true ]; then
    log "[DRY-RUN] would run sshd -t and systemctl restart $ssh_service_name"
  else
    if sshd -t 2>/tmp/sshd_test_err || true; then
      log "sshd config test passed"
    else
      log "sshd config test failed. Error:"
      sed -n '1,200p' /tmp/sshd_test_err || true
    fi

    # generate missing host keys if needed
    if [ -d /etc/ssh ]; then
      log "Ensuring system host keys exist (ssh-keygen -A)"
      ssh-keygen -A || true
    fi

    # ensure runtime dir exists
    mkdir -p /var/run/sshd
    chmod 0755 /var/run/sshd || true

    # attempt restart
    if ! systemctl restart "$ssh_service_name"; then
      log "ssh service restart failed. Collecting journal..."
      journalctl -u "$ssh_service_name" -n 200 --no-pager | tee -a "$LOGFILE"
      # attempt restore from backup if available
      if [ -d "$BACKUP_DIR" ]; then
        log "Attempting to restore /etc/ssh and machine-id from backup: $BACKUP_DIR"
        # restore /etc/ssh if present
        if [ -e "${BACKUP_DIR}/backup-ssh.tar.gz" ] || [ -n "$(ls ${BACKUP_DIR} 2>/dev/null)" ]; then
          # try to extract any ssh backup tarball that matches
          for f in "$BACKUP_DIR"/*.tar.gz "$BACKUP_DIR"/backup-ssh*; do
            [ -f "$f" ] || continue
            tar -xzf "$f" -C / || true
            log "Restored from $f"
          done
        fi
        # restore machine-id file if present
        if [ -f "${BACKUP_DIR}/etc/machine-id" ]; then
          cp -a "${BACKUP_DIR}/etc/machine-id" /etc/machine-id || true
          ln -sf /etc/machine-id /var/lib/dbus/machine-id || true
          log "Restored machine-id"
        fi
      fi

      # optionally reinstall openssh-server
      if [ "$AUTO_FIX_SSH" = true ]; then
        log "Attempting to reinstall openssh-server to recover service (requires network & apt)."
        if command -v apt-get >/dev/null 2>&1 && [ "$DRY_RUN" = false ]; then
          apt-get update || true
          apt-get install --reinstall -y openssh-server || true
          systemctl restart "$ssh_service_name" || true
          journalctl -u "$ssh_service_name" -n 200 --no-pager | tee -a "$LOGFILE"
        else
          log "Auto-fix skipped: apt-get not available or dry-run mode."
        fi
      else
        log "Auto-fix disabled (--no-auto-fix-ssh). Manual intervention required."
      fi
    else
      log "SSH restarted successfully."
    fi
  fi
else
  log "-> SSH keys were not changed by this run (keys preserved). No SSH restart attempted."
fi

log "===== Done ====="
if [ "$DRY_RUN" = true ]; then
  log "Dry run: no destructive actions performed. Review output/log $LOGFILE and re-run without --dry-run to apply."
else
  log "Real run completed. Backups (if any) are in $BACKUP_DIR. Log at $LOGFILE"
fi

exit 0

