#!/bin/bash
# =============================================================================
# base/hooks/chroot/0460-motd.hook.chroot
#
# Hand the login message over to /etc/update-motd.d/10-welcome.
# Configuration only — no packages installed here.
# =============================================================================
set -euo pipefail

# Debian's static warranty blurb. pam_motd still prints /etc/motd (noupdate line),
# so leave it empty rather than deleting it — admins can still write a notice here.
: > /etc/motd

# base-files' 10-uname would print a raw `uname -a` above our greeting.
# Divert rather than chmod -x: a diversion survives base-files upgrades.
# run-parts --lsbsysinit skips names containing '.', so the diverted file is inert.
dpkg-divert --local --rename \
    --divert /etc/update-motd.d/10-uname.disabled \
    --add /etc/update-motd.d/10-uname

chmod 0755 /etc/update-motd.d/10-welcome /usr/bin/os-welcome
chmod 0644 /usr/lib/os-motd/*.sh
